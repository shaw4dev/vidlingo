# Keep the build context small and the image reproducible: anything here is
# either regenerated inside the build, or must never end up in a shipped image.

.git
.github
.claude

# Secrets — a .env in the context can be COPYd in by accident.
.env
.env.*
!.env.example

# Regenerated by the build stages.
**/node_modules
web/dist
**/__pycache__
**/*.py[cod]
backend/.venv
backend/*.egg-info

# Local state and caches.
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/.coverage
**/htmlcov
*.db
*.sqlite3

# Content and docs the runtime doesn't read.
content/
data/
ios/
*.md
