# Copy to .env and adjust. Used by docker-compose.yml.
# Postgres credentials (also compose into the API's DATABASE_URL).
POSTGRES_USER=vidlingo
POSTGRES_PASSWORD=vidlingo
POSTGRES_DB=vidlingo

# JWT signing secret. MUST be a strong random value in prod (T10).
SECRET_KEY=dev-insecure-change-me

# Set to 1 to load the demo lesson + user on container start.
SEED_ON_START=0

# Optional — content sourcing (T17). YouTube Data API v3 key enables discovery
# and on-demand word backfill; without it the API runs and backfill no-ops.
YOUTUBE_API_KEY=
# Optional — real zh translation for auto-ingested lessons (placeholder if unset)
# and the Chinese gloss on the word card (T13); the card falls back to English
# senses without it. One call per new word, then cached in the DB forever.
ANTHROPIC_API_KEY=

# Translation provider. Anything that speaks the Anthropic Messages API works;
# leave both unset for Anthropic itself. The API key above is whichever
# provider's key matches the base URL.
#   DeepSeek: ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_BASE_URL=
TRANSLATE_MODEL=
